<launch>
  <arg name="task" default="hover"/>
  <arg name="start_task" default="false"/>
  <arg name="if_debug" default="0" doc="0: wait for manual OFFBOARD; arming logic is still present"/>
  <group if="$(arg start_task)">
    <param name="use_sim_time" value="false"/>
    <rosparam command="load" file="$(find mission)/config/$(arg task).yaml"/>
    <param name="if_debug" type="double" value="$(arg if_debug)"/>
    <node pkg="mission" type="$(arg task)" name="$(arg task)" output="screen"
          launch-prefix="$(find mission)/scripts/task_stdin.sh"/>
  </group>
</launch>
